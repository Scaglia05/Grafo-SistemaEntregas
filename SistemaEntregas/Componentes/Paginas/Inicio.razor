@page "/"
@using System.Globalization
@inject ServicoGrafo Grafo
@inject ServicoDijkstra Dijkstra
@inject ServicoBellmanFord BellmanFord
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Calcular Rota</PageTitle>

<h1>Qual o melhor caminho de entrega?</h1>
<p class="subtitulo">Escolha de onde a entrega sai e para quem ela vai. O mapa mostra o melhor caminho.</p>

<div class="grid-calculadora">
    <section class="painel">
        <label>
            1. A entrega sai de
            <select @bind="_origemId" @bind:after="Calcular">
                @foreach (var c in Grafo.Centros)
                {
                    <option value="@c.Id">@c.Nome</option>
                }
            </select>
        </label>

        <label>
            2. E vai para
            <select @bind="_destinoId" @bind:after="Calcular">
                @foreach (var c in Grafo.Clientes)
                {
                    <option value="@c.Id">@c.Nome</option>
                }
            </select>
        </label>

        <div>
            <span class="rotulo">3. O que importa mais?</span>
            <div class="opcoes">
                <button class="@ClasseOpcao(Criterio.Distancia)" @onclick="() => Escolher(Criterio.Distancia)">📏 Menor distância</button>
                <button class="@ClasseOpcao(Criterio.Custo)" @onclick="() => Escolher(Criterio.Custo)">💰 Menor custo</button>
            </div>
        </div>

        @if (_dijkstra is { Encontrado: false })
        {
            <p class="aviso erro">@_dijkstra.Mensagem</p>
        }
        else if (_dijkstra is not null && _bellman is not null)
        {
            <div class="resultado">
                <span class="rotulo">Melhor caminho</span>
                <p class="rota-texto">@string.Join(" → ", _dijkstra.Caminho.Select(n => n.Nome))</p>
                <p class="total">@Formatar(_dijkstra.PesoTotal)</p>
            </div>

            <details>
                <summary>Comparar os algoritmos</summary>
                <table class="tabela-resultado">
                    <thead>
                        <tr><th></th><th>Dijkstra</th><th>Bellman-Ford</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Total</td><td>@Formatar(_dijkstra.PesoTotal)</td><td>@Formatar(_bellman.PesoTotal)</td></tr>
                        <tr><td>Nós visitados</td><td>@_dijkstra.NosVisitados</td><td>@_bellman.NosVisitados</td></tr>
                        <tr><td>Arestas relaxadas</td><td>@_dijkstra.ArestasRelaxadas</td><td>@_bellman.ArestasRelaxadas</td></tr>
                        <tr><td>Tempo (µs)</td><td>@_dijkstra.TempoMicrossegundos.ToString("0.#", Pt)</td><td>@_bellman.TempoMicrossegundos.ToString("0.#", Pt)</td></tr>
                    </tbody>
                </table>
                <p class="aviso @(Concordam ? "ok" : "erro")">
                    @(Concordam ? "✔ Os dois algoritmos chegaram ao mesmo resultado." : "✗ Os algoritmos divergem.")
                </p>
            </details>
        }
    </section>

    <div id="mapa" class="mapa"></div>
</div>

@code {
    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");

    private string _origemId = "";
    private string _destinoId = "";
    private Criterio _criterio = Criterio.Distancia;
    private ResultadoCaminho? _dijkstra;
    private ResultadoCaminho? _bellman;

    private bool Concordam => Math.Abs(_dijkstra!.PesoTotal - _bellman!.PesoTotal) < 0.01;

    private string ClasseOpcao(Criterio criterio) => criterio == _criterio ? "ativo" : "";

    private string Formatar(double valor) => _criterio == Criterio.Distancia
        ? $"{valor.ToString("0.#", Pt)} km"
        : $"R$ {valor.ToString("N2", Pt)}";

    protected override void OnInitialized()
    {
        _origemId = Grafo.Centros.FirstOrDefault()?.Id ?? "";
        _destinoId = Grafo.Clientes.FirstOrDefault()?.Id ?? "";
    }

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (!primeiroRender) return;

        var nos = Grafo.Nos.Select(n => new
        {
            id = n.Id,
            nome = n.Nome,
            tipo = n.Tipo.ToString(),
            lat = n.Latitude,
            lng = n.Longitude
        });
        var arestas = Grafo.Rotas.Select(r => new { origem = r.OrigemId, destino = r.DestinoId });

        await JS.InvokeVoidAsync("mapaEntregas.inicializar", "mapa", nos, arestas);

        await Calcular();
        StateHasChanged();
    }

    private Task Escolher(Criterio criterio)
    {
        _criterio = criterio;
        return Calcular();
    }

    private async Task Calcular()
    {
        _dijkstra = _bellman = null;

        if (_origemId != "" && _destinoId != "")
        {
            _dijkstra = Dijkstra.Calcular(Grafo, _origemId, _destinoId, _criterio);
            _bellman = BellmanFord.Calcular(Grafo, _origemId, _destinoId, _criterio);
        }

        var coordenadas = (_dijkstra?.Caminho ?? new List<NoGrafo>())
            .Select(n => new[] { n.Latitude, n.Longitude });
        await JS.InvokeVoidAsync("mapaEntregas.desenharCaminho", coordenadas);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("mapaEntregas.destruir");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
