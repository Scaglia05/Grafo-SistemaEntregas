@page "/grafo"
@inject ServicoGrafo Dados

<PageTitle>Cadastros</PageTitle>

<h1>Cadastros</h1>
<p class="subtitulo">Adicione novos locais e rotas. Eles passam a aparecer na tela "Calcular rota".</p>

<div class="grid-gestao">
    <section class="painel">
        <h2>Novo local</h2>
        <label>
            Nome
            <input @bind="_noNome" />
        </label>
        <label>
            Tipo
            <select @bind="_noTipo">
                <option value="@TipoNo.Cliente">Cliente</option>
                <option value="@TipoNo.CentroDistribuicao">Centro de distribuição</option>
            </select>
        </label>
        <label>
            Latitude
            <input type="number" step="any" @bind="_noLat" />
        </label>
        <label>
            Longitude
            <input type="number" step="any" @bind="_noLng" />
        </label>
        <small>Dica: no Google Maps, clique com o botão direito no local e copie as coordenadas.</small>
        <button @onclick="AdicionarNo" disabled="@(!PodeAdicionarNo)">Adicionar local</button>
    </section>

    <section class="painel">
        <h2>Nova rota</h2>
        <label>
            De
            <select @bind="_rotaDe">
                <option value="">— selecione —</option>
                @foreach (var n in Dados.Nos)
                {
                    <option value="@n.Id">@n.Rotulo</option>
                }
            </select>
        </label>
        <label>
            Para
            <select @bind="_rotaPara">
                <option value="">— selecione —</option>
                @foreach (var n in Dados.Nos)
                {
                    <option value="@n.Id">@n.Rotulo</option>
                }
            </select>
        </label>
        <label>
            Custo (R$)
            <input type="number" step="any" @bind="_rotaCusto" />
        </label>
        <label>
            Distância (km) — deixe 0 para calcular sozinho
            <input type="number" step="any" @bind="_rotaDistancia" />
        </label>
        <label class="checkbox">
            <input type="checkbox" @bind="_rotaIdaEVolta" /> Vale nos dois sentidos
        </label>
        <button @onclick="AdicionarRota" disabled="@(!PodeAdicionarRota)">Adicionar rota</button>
    </section>
</div>

<h2>Locais (@Dados.Nos.Count)</h2>
<table class="tabela-dados">
    <thead>
        <tr><th>Local</th><th>Tipo</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var n in Dados.Nos)
        {
            <tr>
                <td>@n.Rotulo</td>
                <td>@(n.Tipo == TipoNo.CentroDistribuicao ? "Centro de distribuição" : "Cliente")</td>
                <td><button class="link" @onclick="() => Dados.RemoverNo(n.Id)">remover</button></td>
            </tr>
        }
    </tbody>
</table>

<h2>Rotas (@Dados.Rotas.Count)</h2>
<table class="tabela-dados">
    <thead>
        <tr><th>Rota</th><th>Distância (km)</th><th>Custo (R$)</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var r in Dados.Rotas)
        {
            <tr>
                <td>@Dados.BuscarNo(r.OrigemId)?.Nome @(r.Bidirecional ? "↔" : "→") @Dados.BuscarNo(r.DestinoId)?.Nome</td>
                <td>@r.DistanciaKm</td>
                <td>@r.Custo.ToString("0.##")</td>
                <td><button class="link" @onclick="() => Dados.RemoverRota(r.Id)">remover</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string _noNome = "";
    private TipoNo _noTipo = TipoNo.Cliente;
    private double _noLat;
    private double _noLng;

    private string _rotaDe = "";
    private string _rotaPara = "";
    private double _rotaCusto;
    private double _rotaDistancia;
    private bool _rotaIdaEVolta = true;

    private bool PodeAdicionarNo =>
        !string.IsNullOrWhiteSpace(_noNome) && Math.Abs(_noLat) <= 90 && Math.Abs(_noLng) <= 180;

    private bool PodeAdicionarRota =>
        _rotaDe != "" && _rotaPara != "" && _rotaDe != _rotaPara;

    private void AdicionarNo()
    {
        Dados.AdicionarNo(new NoGrafo
        {
            Nome = _noNome.Trim(),
            Tipo = _noTipo,
            Latitude = _noLat,
            Longitude = _noLng
        });

        _noNome = "";
        _noLat = _noLng = 0;
    }

    private void AdicionarRota()
    {
        Dados.AdicionarRota(new Rota
        {
            OrigemId = _rotaDe,
            DestinoId = _rotaPara,
            Custo = _rotaCusto,
            DistanciaKm = _rotaDistancia,
            Bidirecional = _rotaIdaEVolta
        });

        _rotaDe = _rotaPara = "";
        _rotaCusto = _rotaDistancia = 0;
        _rotaIdaEVolta = true;
    }
}
